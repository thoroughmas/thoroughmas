---
const today = new Date();
---

<!-- Sticky social bar: fixed at viewport bottom until footer arrives -->
<div id='sticky-social-bar' class='sticky-social-bar'>
	<div class='flex gap-3 py-4 justify-center items-center flex-wrap'>
		<a
			href='https://bsky.app/profile/thomid.me'
			target='_blank'
			rel='me noopener noreferrer'
			class='social-link text-zinc-600 dark:text-zinc-400 text-sm font-medium transition-colors duration-200 no-underline'
			data-platform='bluesky'
			title='Bluesky'
		>
			Bluesky
		</a>
		<span class='text-zinc-400 dark:text-zinc-500 text-xs'>·</span>
		<a
			href='https://mastodon.au/@thoroughmas'
			target='_blank'
			rel='me noopener noreferrer'
			class='social-link text-zinc-600 dark:text-zinc-400 text-sm font-medium transition-colors duration-200 no-underline'
			data-platform='mastodon'
			title='Mastodon'
		>
			Mastodon
		</a>
		<span class='text-zinc-400 dark:text-zinc-500 text-xs'>·</span>
		<a
			href='https://pixelfed.au/thoroughmas'
			target='_blank'
			rel='me noopener noreferrer'
			class='social-link text-zinc-600 dark:text-zinc-400 text-sm font-medium transition-colors duration-200 no-underline'
			data-platform='pixelfed'
			title='Pixelfed'
		>
			Pixelfed
		</a>
		<span class='text-zinc-400 dark:text-zinc-500 text-xs'>·</span>
		<a
			href='https://www.instagram.com/thoroughmas'
			target='_blank'
			rel='me noopener noreferrer'
			class='social-link text-zinc-600 dark:text-zinc-400 text-sm font-medium transition-colors duration-200 no-underline'
			data-platform='instagram'
			title='Instagram'
		>
			Instagram
		</a>
		<span class='text-zinc-400 dark:text-zinc-500 text-xs'>·</span>
		<a
			href='https://spool.au/@thomas'
			target='_blank'
			rel='me noopener noreferrer'
			class='social-link text-zinc-600 dark:text-zinc-400 text-sm font-medium transition-colors duration-200 no-underline'
			data-platform='loops'
			title='Loops'
		>
			Loops
		</a>
		<span class='text-zinc-400 dark:text-zinc-500 text-xs'>·</span>
		<a
			href='https://www.tiktok.com/@thoroughmas'
			target='_blank'
			rel='noopener noreferrer'
			class='social-link text-zinc-600 dark:text-zinc-400 text-sm font-medium transition-colors duration-200 no-underline'
			data-platform='tiktok'
			title='TikTok'
		>
			TikTok
		</a>
		<span class='text-zinc-400 dark:text-zinc-500 text-xs'>·</span>
		<a
			href='https://youtube.com/@thoroughmas'
			target='_blank'
			rel='noopener noreferrer'
			class='social-link text-zinc-600 dark:text-zinc-400 text-sm font-medium transition-colors duration-200 no-underline'
			data-platform='youtube'
			title='YouTube'
		>
			YouTube
		</a>
		<span class='text-zinc-400 dark:text-zinc-500 text-xs'>·</span>
		<a
			href='https://codec.au/a/thomas'
			target='_blank'
			rel='me noopener noreferrer'
			class='social-link text-zinc-600 dark:text-zinc-400 text-sm font-medium transition-colors duration-200 no-underline'
			data-platform='peertube'
			title='PeerTube'
		>
			PeerTube
		</a>
		<span class='text-zinc-400 dark:text-zinc-500 text-xs'>·</span>
		<a
			href='https://matrix.to/#/@thomas:thicket.au'
			target='_blank'
			rel='noopener noreferrer'
			class='social-link text-zinc-600 dark:text-zinc-400 text-sm font-medium transition-colors duration-200 no-underline'
			data-platform='matrix'
			title='Matrix'
		>
			Matrix
		</a>
		<span class='text-zinc-400 dark:text-zinc-500 text-xs'>·</span>
		<a
			href='mailto:thomas@thomid.me'
			class='social-link text-zinc-600 dark:text-zinc-400 text-sm font-medium transition-colors duration-200 no-underline'
			data-platform='email'
			title='Contact'
		>
			Email
		</a>
		<span class='text-zinc-400 dark:text-zinc-500 text-xs'>·</span>
		<a
			href='/rss.xml'
			target='_blank'
			rel='noopener noreferrer'
			class='social-link text-zinc-600 dark:text-zinc-400 text-sm font-medium transition-colors duration-200 no-underline'
			data-platform='rss'
			title='RSS'
		>
			RSS
		</a>
	</div>
</div>

<footer id='page-footer' class='container mt-8'>
	<div class='py-4 border-t dark:border-t-zinc-700'>
		<div class='md:flex text-sm text-zinc-500/80 dark:text-zinc-400/70 justify-between'>
			<div class='text-sm text-zinc-500/80 dark:text-zinc-400/70'>Copyright © {today.getFullYear()} Thomas.</div>
			<div class='text-xs text-zinc-400 dark:text-zinc-500 opacity-60 hover:opacity-100 transition-opacity duration-200 mt-1 md:mt-0'>
				Template by <a
					href='https://devaradise.com/'
					target='_blank'
					rel='nofollow noopener'
					class='text-inherit hover:text-zinc-600 dark:hover:text-zinc-400'>Syakir</a
				>
			</div>
		</div>
	</div>
</footer>

<script>
	const bar = document.getElementById('sticky-social-bar');
	const footer = document.getElementById('page-footer');

	if (bar && footer) {
		const observer = new IntersectionObserver(
			([entry]) => {
				bar.classList.toggle('is-docked', entry.isIntersecting);
				// Only add padding back when undocking (footer has scrolled back up / away).
				// When docking, no padding needed — the bar is already in-flow above it.
				if (!entry.isIntersecting) {
					footer.style.paddingBottom = '5rem';
				}
			},
			{ rootMargin: '0px 0px -80px 0px', threshold: 0 }
		);
		observer.observe(footer);
	}
</script>

<style>
	.sticky-social-bar {
		position: fixed;
		bottom: 0;
		left: 0;
		right: 0;
		background: rgba(255, 255, 255, 0.9);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
		border-top: 1px solid #e4e4e7;
		z-index: 50;
	}

	.sticky-social-bar.is-docked {
		position: relative;
		border-top: none;
	}

	:global(.dark) .sticky-social-bar {
		background: rgba(23, 23, 23, 0.9);
		border-top-color: #44403c;
	}

	:global(.dark) .sticky-social-bar.is-docked {
		border-top-color: transparent;
	}

	/* ── Platform hover colours ── */
	.social-link:hover {
		text-decoration: none;
	}
	.social-link[data-platform='bluesky']:hover {
		color: #1185fe !important;
	}
	.social-link[data-platform='mastodon']:hover {
		color: #6364ff !important;
	}
	.social-link[data-platform='pixelfed']:hover {
		color: #00daf6 !important;
	}
	.social-link[data-platform='instagram']:hover {
		color: #e1306c !important;
	}
	.social-link[data-platform='loops']:hover {
		color: #facc15 !important;
	}
	.social-link[data-platform='tiktok']:hover {
		color: #fe2c55 !important;
	}
	.social-link[data-platform='youtube']:hover {
		color: #ff0000 !important;
	}
	.social-link[data-platform='peertube']:hover {
		color: #ffa13c !important;
	}
	.social-link[data-platform='matrix']:hover {
		color: #0f0f0f !important;
	}
	.social-link[data-platform='email']:hover {
		color: #3b82f6 !important;
	}
	.social-link[data-platform='rss']:hover {
		color: #f97316 !important;
	}

	:global(.dark) .social-link[data-platform='peertube']:hover {
		color: #ffa13c !important;
	}
	:global(.dark) .social-link[data-platform='matrix']:hover {
		color: #a78bfa !important;
	}
</style>
