---
interface Props {
	date: Date;
	showYear?: boolean;
}

const { date } = Astro.props;
---

<time datetime={date.toISOString()} class='text-zinc-500 dark:text-zinc-400 tabular-nums'>
	{
		date.toLocaleDateString('en-us', {
			month: 'short',
			day: 'numeric',
			year: Astro.props.showYear ? 'numeric' : undefined,
			timeZone: 'Australia/Adelaide'
		})
	}
</time>
