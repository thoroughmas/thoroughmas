---
import BaseHead from './components/BaseHead.astro';
import Header from './components/Header.astro';
import Footer from './components/Footer.astro';

const { title, description, image } = Astro.props;
---

<!doctype html>
<html lang='en' prefix='og: https://ogp.me/ns#'>
	<head>
		<BaseHead title={title} description={description} image={image} />

		{/* Open Graph metadata */}
		<meta property='og:type' content='website' />
		{image && <meta property='og:image' content={image} />}
	</head>

	<body class='bg-white dark:bg-zinc-900 dark:text-zinc-100 pt-16 sm:pt-0' itemscope itemtype='https://schema.org/WebPage'>
		<Header />
		<div class='py-8 min-h-[calc(100vh-160px)]' itemprop='mainContentOfPage'>
			<slot />
		</div>
		<Footer />

		<!-- Umami Analytics -->
		<script defer src='https://umami.thicket.au/script.js' data-website-id='5856ddeb-e4cb-469d-ab9d-65f0913160bb'></script>
	</body>
</html>
